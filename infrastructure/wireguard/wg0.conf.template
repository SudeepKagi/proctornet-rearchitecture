# =============================================================================
# ProctorNet Secure Management Plane Gateway Configuration
# Interface: wg0
# Canonical Management Subnet: 10.100.0.0/24
# Gateway IP: 10.100.0.1/24
# Ingress Port: UDP 51820
# MTU: 1420
#
# Isolation Guarantees:
# - Strictly isolates developer operations, SSH, and telemetry plane.
# - Zero interference with candidate WebRTC media (UDP 40000-49999) or HTTPS (TCP 443).
# =============================================================================

[Interface]
Address = 10.100.0.1/24
ListenPort = 51820
PrivateKey = ${SERVER_PRIVATE_KEY}
MTU = 1420

# Enable IP forwarding and NAT for the management subnet upon startup
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -A POSTROUTING -s 10.100.0.0/24 -o eth0 -j MASQUERADE
# Restrict port 22 (SSH) to incoming traffic from wg0 (10.100.0.0/24)
PostUp = iptables -A INPUT -p tcp --dport 22 -i wg0 -s 10.100.0.0/24 -j ACCEPT
PostUp = iptables -A INPUT -p tcp --dport 22 -i eth0 -j DROP

# Teardown rules upon shutdown
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -s 10.100.0.0/24 -o eth0 -j MASQUERADE
PostDown = iptables -D INPUT -p tcp --dport 22 -i wg0 -s 10.100.0.0/24 -j ACCEPT
PostDown = iptables -D INPUT -p tcp --dport 22 -i eth0 -j DROP

