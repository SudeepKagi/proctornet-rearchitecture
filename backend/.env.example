# ==============================================================================
# ProctorNet Backend Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# Never commit .env with real credentials to source control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proctornet
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Optional full connection URL (overrides DB_* if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proctornet
