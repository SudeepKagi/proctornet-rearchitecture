# ==============================================================================
# ProctorNet Backend Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# Never commit .env with real credentials to source control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proctornet
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Optional full connection URL (overrides DB_* if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proctornet

# Authentication & Security Configuration
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-minimum-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-minimum-32-chars
JWT_REFRESH_EXPIRATION=7d
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# Metrics & Observability Configuration
METRICS_ENABLED=true
# Optional token for scraping /metrics endpoint
# METRICS_AUTH_TOKEN=your-prometheus-scraper-token
