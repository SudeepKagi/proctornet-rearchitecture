{
  "name": "proctornet-backend",
  "version": "0.1.0",
  "description": "ProctorNet Modular Monolith Backend API Service",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "db:migrate": "node src/infrastructure/postgres/migrate.js up",
    "db:rollback": "node src/infrastructure/postgres/migrate.js down",
    "db:create": "npx node-pg-migrate create --migrations-dir migrations --migration-file-language js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "proctornet",
    "examination",
    "proctoring",
    "backend"
  ],
  "author": "ProctorNet Team",
  "license": "MIT"
}
