{
  "name": "proctornet-backend",
  "version": "0.1.0",
  "description": "ProctorNet Modular Monolith Backend API Service",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:migrate": "node src/infrastructure/postgres/migrate.js up",
    "db:rollback": "node src/infrastructure/postgres/migrate.js down",
    "db:create": "npx node-pg-migrate create --migrations-dir migrations --migration-file-language js",
    "db:seed": "node ../scripts/db/reset-and-seed.js",
    "seed:users": "node ../scripts/db/seed-default-users.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "amqplib": "^0.10.5",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.26.0",
    "multer": "^2.3.0",
    "node-pg-migrate": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "keywords": [
    "proctornet",
    "examination",
    "proctoring",
    "backend"
  ],
  "author": "ProctorNet Team",
  "license": "MIT"
}
