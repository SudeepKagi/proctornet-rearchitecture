{
  "name": "proctornet-backend",
  "version": "0.1.0",
  "description": "ProctorNet Modular Monolith Backend API Service",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch",
    "db:migrate": "node src/infrastructure/postgres/migrate.js up",
    "db:rollback": "node src/infrastructure/postgres/migrate.js down",
    "db:create": "npx node-pg-migrate create --migrations-dir migrations --migration-file-language js",
    "bench:smoke": "k6 run ../scripts/load/k6/smoke-test.js",
    "bench:seed": "node ../scripts/load/seed-benchmark-data.js",
    "bench:cleanup": "node ../scripts/load/cleanup-benchmark-data.js",
    "bench:verify": "node ../scripts/load/verify-data-integrity.js",
    "bench:run": "node ../scripts/load/run-benchmarks.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "amqplib": "^0.10.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mediasoup": "^3.26.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "artillery": "^2.0.34",
    "ioredis-mock": "^8.13.1",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "keywords": [
    "proctornet",
    "examination",
    "proctoring",
    "backend"
  ],
  "author": "ProctorNet Team",
  "license": "MIT"
}
