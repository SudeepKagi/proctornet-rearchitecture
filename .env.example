# ==============================================================================
# ProctorNet Platform Configuration Template (.env.example)
# Copy this file to .env in the repository root for local Docker Compose or EC2.
#
# INVARIANTS:
# - In local development: Defaults provided below work out-of-the-box.
# - In production (NODE_ENV=production): Fail-closed security applies.
#   Variables marked [REQUIRED IN PRODUCTION] MUST be set to strong values.
#   Never commit .env containing production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_PORT=8080

# Production Domain & Email (Used for Let's Encrypt TLS & Nginx Virtual Host)
# [REQUIRED IN PRODUCTION]
DOMAIN_NAME=exam.proctornet.com
ADMIN_EMAIL=admin@proctornet.com

# ------------------------------------------------------------------------------
# 2. CORS Allowed Origins
# In production, must be HTTPS, comma-separated, without wildcards.
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=proctornet
DB_USER=postgres
# [REQUIRED IN PRODUCTION: Strong password >= 16 chars]
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
# Optional full connection URL (overrides DB_* if specified)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/proctornet

# ------------------------------------------------------------------------------
# 4. Redis Ephemeral Cache & Pub/Sub
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
# [REQUIRED IN PRODUCTION: Strong password >= 24 chars]
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 5. RabbitMQ Asynchronous Broker
# ------------------------------------------------------------------------------
RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
# [REQUIRED IN PRODUCTION: Strong password >= 16 chars]
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT_SEC=60
RABBITMQ_PREFETCH=10
RABBITMQ_DISPATCH_INTERVAL_MS=5000
RABBITMQ_CONNECT_TIMEOUT_MS=5000
RABBITMQ_MANDATORY_TIMEOUT_MS=5000
# Optional connection URL:
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ------------------------------------------------------------------------------
# 6. Authentication & Security (JWT)
# Secrets must be at least 32 characters in production.
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION]
JWT_ACCESS_SECRET=proctornet-dev-jwt-access-secret-32-chars-long
JWT_ACCESS_EXPIRATION=15m
# [REQUIRED IN PRODUCTION]
JWT_REFRESH_SECRET=proctornet-dev-jwt-refresh-secret-32-chars-long
JWT_REFRESH_EXPIRATION=7d
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# ------------------------------------------------------------------------------
# 7. Metrics & Observability (Prometheus)
# ------------------------------------------------------------------------------
METRICS_ENABLED=true
# [REQUIRED IN PRODUCTION: Bearer token for scraping /metrics]
METRICS_AUTH_TOKEN=proctornet-dev-metrics-auth-token-32-chars

# ------------------------------------------------------------------------------
# 8. S3 Evidence Storage (Phase 15)
# In local development: LocalStack emulates S3 on port 4566.
# In production: AWS IAM Instance Profile handles auth; leave S3_ENDPOINT blank.
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET_NAME=proctornet-evidence-dev-01
S3_ENDPOINT=http://localstack:4566
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVIDENCE_RETENTION_DAYS=90
EVIDENCE_UPLOAD_TTL_SECONDS=300
EVIDENCE_PLAYBACK_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 9. Realtime WebSocket Control Plane (Phase 16)
# ------------------------------------------------------------------------------
WS_ENABLED=true
WS_PRE_AUTH_RATE_LIMIT_PER_MIN=30
WS_TRANSPORT_PING_INTERVAL_MS=30000
WS_PRESENCE_SWEEP_INTERVAL_MS=5000
WS_PRESENCE_LAPSE_THRESHOLD_MS=15000
WS_MAX_PAYLOAD_BYTES=16384
WS_MAX_CONNECTIONS_PER_USER=3
WS_TRUSTED_PROXY_COUNT=1
WS_INBOUND_RATE_LIMIT_PER_MIN=60
WS_REVOCATION_SWEEP_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# 10. WebRTC / SFU Media Plane (Phase 17) & Coturn TURN Relay
#
# CLIENT REACHABILITY & NETWORK SEMANTICS:
# - MEDIA_LISTEN_IP: Bind interface (0.0.0.0 inside container).
# - MEDIA_ANNOUNCED_IP: Advertised in WebRTC ICE candidates for direct SFU media.
#   * For same-host testing (browser on host running Docker): 127.0.0.1
#   * For multi-device / remote LAN testing: set to host's LAN IP (e.g. 192.168.1.50)
#     and ensure UDP ports 40000-40050 are open in the host firewall.
#   * For production: set to EC2 public Elastic IP [REQUIRED IN PRODUCTION].
# - TURN_ANNOUNCED_HOST: Advertised host in TURN_SERVER_URL for Coturn relay.
#   * For same-host testing: 127.0.0.1
#   * For multi-device / remote LAN testing: set to host's LAN IP
#     and ensure UDP/TCP 3478 and UDP 49152-49250 are open in host firewall.
#   * For production: set to EC2 public Elastic IP or domain name.
# ------------------------------------------------------------------------------
MEDIA_ENABLED=true
MEDIA_LISTEN_IP=0.0.0.0
MEDIA_ANNOUNCED_IP=127.0.0.1
MEDIA_MIN_PORT=40000
MEDIA_MAX_PORT=40050
# Production media port range is 40000-49999
MEDIASOUP_NUM_WORKERS=
STUN_SERVER_URL=stun:stun.l.google.com:19302

# TURN Server Settings (Coturn)
TURN_ANNOUNCED_HOST=127.0.0.1
TURN_SERVER_URL=turn:127.0.0.1:3478
# [REQUIRED IN PRODUCTION: Shared HMAC-SHA1 secret >= 16 chars]
TURN_STATIC_AUTH_SECRET=proctornet-static-turn-secret-32-chars
TURN_CREDENTIAL_TTL_SEC=900
WS_MEDIA_RATE_LIMIT_PER_MIN=240
WS_MEDIA_BURST_CAPACITY=60
WS_MEDIA_MAX_PAYLOAD_BYTES=65536
MEDIA_SIGNING_SECRET=proctornet-dev-media-signing-secret-32-chars

# ------------------------------------------------------------------------------
# 11. Security Hardening & Cryptographic Anti-Tamper (Phase 18)
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION: HMAC secret >= 32 chars]
ANTI_TAMPER_SECRET=proctornet-dev-jwt-access-secret-32-chars-long
ANTI_TAMPER_MAX_DRIFT_MS=300000
ALLOW_IN_MEMORY_NONCE_FALLBACK=false
SECURITY_MAGIC_BYTES_VERIFICATION=true
CSP_REPORT_ONLY=false

# ------------------------------------------------------------------------------
# 12. Deployment Container Images (Production)
# ------------------------------------------------------------------------------
BACKEND_IMAGE=proctornet-backend:latest
FRONTEND_IMAGE=proctornet-frontend:latest
